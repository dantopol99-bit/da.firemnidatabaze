# Zkopíruj tento soubor na .env a doplň vlastní hodnoty:
#   cp .env.example .env
# Soubor .env se NEcommituje (je v .gitignore).

# Přihlašovací údaje, se kterými docker-compose vytvoří databázi
POSTGRES_USER=firemni
POSTGRES_PASSWORD=zmen_me_na_silne_heslo
POSTGRES_DB=firemni_databaze

# Kam se připojuje Python (lokální Docker = localhost:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
