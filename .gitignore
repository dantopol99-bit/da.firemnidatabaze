# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtuální prostředí ---
.venv/
venv/

# --- Tajné údaje (hesla, připojení) ---
.env

# --- Data (stažené registry, exporty) — do gitu nepatří ---
/data/*
!/data/.gitkeep

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Interní podklady kontroly reportu (obsahují skrytá čísla) — nezveřejňovat ---
reporty/vystupy/*/_interni/

# --- PDF výstupy reportu vedle JSON (vzorové PDF jsou v reporty/ukazky) ---
reporty/vystupy/*/report.pdf
